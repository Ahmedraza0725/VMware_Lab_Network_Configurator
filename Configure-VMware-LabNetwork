<# : batch script wrapper
@echo off
setlocal
title VMware Lab Network Auto-Configurator
powershell.exe -NoProfile -ExecutionPolicy Bypass -Command "Invoke-Expression (Get-Content -LiteralPath '%~f0' -Raw)"
echo.
pause
exit /b %ERRORLEVEL%
#>

# ==============================================================================
# PURE POWERSHELL EXECUTION (Zero escaping issues, 100% robust)
# ==============================================================================
Clear-Host
Write-Host "==============================================================================" -ForegroundColor Cyan
Write-Host "       VMWARE LAB NETWORK AUTO-CONFIGURATOR (KALI & KIOPTRIX LAB)             " -ForegroundColor Cyan
Write-Host "==============================================================================" -ForegroundColor Cyan
Write-Host ""

$netName = "VMnet8"

# 1. Locate vmrun.exe if available
$vmrunPaths = @(
    "C:\Program Files (x86)\VMware\VMware Workstation\vmrun.exe",
    "C:\Program Files\VMware\VMware Workstation\vmrun.exe",
    "C:\Program Files (x86)\VMware\VMware Player\vmrun.exe",
    "C:\Program Files\VMware\VMware Player\vmrun.exe"
)
$vmrun = $null
foreach ($p in $vmrunPaths) {
    if (Test-Path $p) { $vmrun = $p; break }
}

$runningVms = @()
if ($vmrun) {
    $rawList = & $vmrun list 2>$null
    foreach ($line in $rawList) {
        if ($line -like "*.vmx") { $runningVms += $line.Trim() }
    }
}

# 2. Scan ONLY Imported / Registered Virtual Machines in VMware
Write-Host "[1/3] Scanning VMware Workstation Library for Imported VMs..." -ForegroundColor Cyan

$inventoryPath = "$env:APPDATA\VMware\inventory.vmls"
$registeredVms = @()

if (Test-Path $inventoryPath) {
    $invLines = Get-Content $inventoryPath
    foreach ($line in $invLines) {
        if ($line -match 'vmlist\d+\.config\s*=\s*"([^"]+\.vmx)"') {
            $vmx = $matches[1]
            if ($vmx -and (Test-Path $vmx)) {
                $registeredVms += $vmx
            }
        }
    }
}

# Also include currently running VMs in VMware
foreach ($rvm in $runningVms) {
    if ($rvm -and (Test-Path $rvm) -and ($registeredVms -notcontains $rvm)) {
        $registeredVms += $rvm
    }
}

$registeredVms = $registeredVms | Sort-Object -Unique

if ($registeredVms.Count -eq 0) {
    Write-Host "  [ERROR] No imported VMs found in VMware Workstation Library!" -ForegroundColor Red
    Write-Host "  Please open VMware Workstation and import/open your Kali and Kioptrix VMs first." -ForegroundColor Yellow
    exit 1
}

$patterns = @("kali", "kiop", "metasploit")
$matchedVms = @()

foreach ($vmx in $registeredVms) {
    $fileName = [System.IO.Path]::GetFileNameWithoutExtension($vmx).ToLower()
    foreach ($pat in $patterns) {
        if ($fileName.Contains($pat)) {
            if ($matchedVms -notcontains $vmx) {
                $matchedVms += $vmx
            }
        }
    }
}

if ($matchedVms.Count -eq 0) {
    Write-Host "  [WARNING] No imported VMs matched target keywords (kali, kiop, metasploit)." -ForegroundColor Yellow
    Write-Host "  Imported VMs in library: $($registeredVms -join ', ')" -ForegroundColor Gray
    Write-Host "  Tip: Ensure your VM is opened in VMware Workstation first." -ForegroundColor Yellow
    exit 0
}

Write-Host "  Found $($matchedVms.Count) imported Lab VM(s):" -ForegroundColor Green
foreach ($m in $matchedVms) {
    $name = [System.IO.Path]::GetFileNameWithoutExtension($m)
    Write-Host "   * $name ($m)" -ForegroundColor White
}

# 3. Configure Network Settings in .vmx Files
Write-Host "`n[2/3] Configuring Isolated Network ($netName)..." -ForegroundColor Cyan

function Update-VmxSetting {
    param (
        [string[]]$Lines,
        [string]$Key,
        [string]$Value
    )
    $pattern = "^\s*" + [regex]::Escape($Key) + "\s*=.*"
    $newEntry = "$Key = `"$Value`""
    $found = $false
    $result = @()
    foreach ($l in $Lines) {
        if ($l -match $pattern) {
            $result += $newEntry
            $found = $true
        } else {
            $result += $l
        }
    }
    if (-not $found) {
        $result += $newEntry
    }
    return $result
}

function Remove-VmxSetting {
    param (
        [string[]]$Lines,
        [string]$Key
    )
    $pattern = "^\s*" + [regex]::Escape($Key) + "\s*=.*"
    return ($Lines | Where-Object { $_ -notmatch $pattern })
}

function Test-FileWritable {
    param ([string]$Path)
    try {
        $stream = [System.IO.File]::Open($Path, 'Open', 'ReadWrite', 'None')
        $stream.Close()
        return $true
    } catch {
        return $false
    }
}

foreach ($vmx in $matchedVms) {
    $vmName = [System.IO.Path]::GetFileNameWithoutExtension($vmx)
    Write-Host "`n  [CONFIGURING] $vmName" -ForegroundColor Cyan

    if ($runningVms -contains $vmx) {
        Write-Host "    [SKIP] '$vmName' is currently RUNNING in VMware." -ForegroundColor Yellow
        Write-Host "           Please shut it down first so settings can be written!" -ForegroundColor Red
        continue
    }

    if (-not (Test-FileWritable $vmx)) {
        Write-Host "    [WARNING] '$vmName.vmx' is currently locked by VMware." -ForegroundColor Yellow
        Write-Host "              Please close the VM tab in VMware Workstation and re-run." -ForegroundColor Red
        continue
    }

    # Backup original
    $bakFile = "$vmx.bak"
    if (-not (Test-Path $bakFile)) {
        Copy-Item -Path $vmx -Destination $bakFile -Force
        Write-Host "    + Backup created: $vmName.vmx.bak" -ForegroundColor Gray
    }

    $lines = Get-Content -Path $vmx

    # Remove any conflicting connection types
    $lines = Remove-VmxSetting -Lines $lines -Key "ethernet0.networkName"
    $lines = Remove-VmxSetting -Lines $lines -Key "ethernet0.connectionType"
    $lines = Remove-VmxSetting -Lines $lines -Key "ethernet0.vnet"
    $lines = Remove-VmxSetting -Lines $lines -Key "ethernet0.displayName"

    # Set common isolated lab network settings (Custom VMnet8)
    $lines = Update-VmxSetting -Lines $lines -Key "ethernet0.present" -Value "TRUE"
    $lines = Update-VmxSetting -Lines $lines -Key "ethernet0.startConnected" -Value "TRUE"
    $lines = Update-VmxSetting -Lines $lines -Key "ethernet0.connectionType" -Value "custom"
    $lines = Update-VmxSetting -Lines $lines -Key "ethernet0.vnet" -Value $netName
    $lines = Update-VmxSetting -Lines $lines -Key "ethernet0.displayName" -Value $netName

    if ($vmName.ToLower().Contains("kiop")) {
        # Kioptrix legacy kernel requires vlance (AMD PCnet-PCI II) driver for NAT
        $lines = Update-VmxSetting -Lines $lines -Key "ethernet0.virtualDev" -Value "vlance"
        Write-Host "    + NIC Type: vlance (Legacy Linux 2.4 AMD PCnet Driver Applied)" -ForegroundColor Green

        # Fix non-existent CD-ROM F: drive
        $lines = Remove-VmxSetting -Lines $lines -Key "ide1:0.fileName"
        $lines = Update-VmxSetting -Lines $lines -Key "ide1:0.present" -Value "FALSE"
        $lines = Update-VmxSetting -Lines $lines -Key "ide1:1.present" -Value "FALSE"
        $lines = Update-VmxSetting -Lines $lines -Key "mks.enable3d" -Value "FALSE"
    } else {
        # Kali Linux uses standard e1000
        $lines = Update-VmxSetting -Lines $lines -Key "ethernet0.virtualDev" -Value "e1000"
        Write-Host "    + NIC Type: e1000 (Standard Gigabit Ethernet Driver)" -ForegroundColor Green
    }

    Set-Content -Path $vmx -Value $lines -Encoding Ascii
    Write-Host "    + Attached to Isolated Network: $netName (Custom Switch)" -ForegroundColor Green
}

Write-Host "`n==============================================================================" -ForegroundColor Cyan
Write-Host "                 VMWARE LAB NETWORK CONFIGURED SUCCESSFULLY!                  " -ForegroundColor Green
Write-Host "==============================================================================" -ForegroundColor Cyan
Write-Host "Summary:" -ForegroundColor White
Write-Host "1. Only imported VMs in VMware library were targeted." -ForegroundColor Gray
Write-Host "2. Both Kali and Kioptrix are attached to the same isolated switch ($netName)." -ForegroundColor Gray
Write-Host "3. Kioptrix has the 'vlance' driver enabled so it receives an IP on $netName." -ForegroundColor Gray
Write-Host "4. Bridged adapter is NOT used (center compliance guaranteed)." -ForegroundColor Gray
Write-Host "You can now power on your VMs in VMware!" -ForegroundColor Green
